# ==========================================
# Telegram API Credentials (https://my.telegram.org)
# ==========================================
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# ==========================================
# Telethon Userbot Session String (CRITICAL FOR RENDER)
# Run 'python login_userbot.py' locally once to generate this string!
# ==========================================
TG_SESSION_STRING=

# ==========================================
# Telegram Bot Token (from @BotFather)
# ==========================================
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ==========================================
# Alert Channel ID (Optional, e.g. -1001234567890)
# ==========================================
ALERT_CHANNEL_ID=

# ==========================================
# Admin Telegram User IDs (Comma-separated)
# ==========================================
ADMIN_IDS=1947158378

# ==========================================
# Database & Tracker Settings
# ==========================================
DB_PATH=spydefi.db
TRACK_INTERVAL=3
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=kolinsights

# ==========================================
# Render Cloud Hosting Configuration
# ==========================================
PORT=10000
# Set KEEP_ALIVE_URL to your Render web service URL (e.g. https://spidyfi-bot.onrender.com)
# This pings the bot every 10 mins to keep Render's free tier awake 24/7!
KEEP_ALIVE_URL=

# ==========================================
# Payment & Emoji IDs (Optional)
# ==========================================
DEPOSIT_WALLET_ADDRESS=0xb774E2edd9118274d71d97d9DA7216D8998c36C2
